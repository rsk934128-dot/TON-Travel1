# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Required for Stripe card payment processing.
STRIPE_SECRET_KEY=

# CRYPTORANK_API_KEY: Optional API Key for CryptoRank API v3 (passed in X-Api-Key header).
# Get your API key at https://cryptorank.io/api
CRYPTORANK_API_KEY=

# BOOKING_DEMAND_API_TOKEN / BOOKING_AFFILIATE_ID: Official Booking.com Demand API v3.1 credentials
# Endpoint: https://demandapi.booking.com/3.1/accommodations/search
BOOKING_DEMAND_API_TOKEN=
BOOKING_AFFILIATE_ID="0"

# BOOKING_COM_API_KEY / RAPIDAPI_KEY: Alternative Booking.com / RapidAPI Key
# Get your key at https://rapidapi.com/apidojo/api/booking
BOOKING_COM_API_KEY=
RAPIDAPI_KEY=

# VITE_GOOGLE_CLIENT_ID: Optional Google OAuth 2.0 Web Client ID for Google Drive & Workspace tokens
VITE_GOOGLE_CLIENT_ID="297681442730-gg3thpd82bao3tu4rm61tv1qnio5ehli.apps.googleusercontent.com"
